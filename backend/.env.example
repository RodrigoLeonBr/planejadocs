# Config do PlanejaDocs backend. Copie para .env e ajuste.
# NOTA: o app lê estas variáveis via os.getenv em runtime (sem dotenv);
# exporte-as no ambiente antes de rodar o uvicorn.

PDF2MD_MAX_PAGES=500
PDF2MD_MAX_FILE_SIZE_MB=50
PDF2MD_WRITE_IMAGES=false
PDF2MD_OUTPUT_DIR=./output

# --- OCR (PDFs escaneados ~5%) ---
# Usa RapidOCR (ONNX/CPU), já incluso via rapidocr. Sem binário externo.
# DPI da rasterização de cada página antes do OCR (maior = mais lento/melhor).
PDF2MD_OCR_DPI=200
