# Config do PlanejaDocs backend. Copie para .env e ajuste.
# NOTA: o app lê estas variáveis via os.getenv em runtime (sem dotenv);
# exporte-as no ambiente antes de rodar o uvicorn.

PDF2MD_MAX_PAGES=500
PDF2MD_MAX_FILE_SIZE_MB=50
PDF2MD_WRITE_IMAGES=false

# --- OCR (opcional, só p/ PDFs escaneados ~5%) ---
# marker-pdf 2.x usa surya via backend llama.cpp e precisa do binário
# llama-server. Baixe um build prebuilt (ggml-org/llama.cpp releases) e
# aponte aqui. Sem isto, PDFs escaneados retornam PDF2MD_004.
LLAMA_CPP_BINARY=E:/tools/llama-cpp/llama-server.exe
